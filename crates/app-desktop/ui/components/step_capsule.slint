// CodexStepCapsule — a tool call compressed to a single 28px status line.
// Spec: codex-desktop-design.md §3.

import { CodexTheme } from "../codex_theme.slint";
import { ActionStepData } from "../globals.slint";

export component CodexStepCapsule inherits Rectangle {
    in property <ActionStepData> step;
    callback approve(int);
    callback deny(int);

    // Grows when a pending approval shows the inline review row.
    height: step.state == "awaiting_confirm" ? 56px : 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: step.state == "awaiting_confirm"
        ? CodexTheme.accent
        : CodexTheme.border_hairline;
    background: CodexTheme.bg_card;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        // status glyph
        Text {
            text: step.state == "running"   ? "●"
                : step.state == "success"   ? "✓"
                : step.state == "error"     ? "✗"
                : step.state == "denied"    ? "⊘"
                : "◌"; // awaiting_confirm
            color: step.state == "running"   ? CodexTheme.status_running
                 : step.state == "success"   ? CodexTheme.diff_add
                 : step.state == "error"     ? CodexTheme.diff_del
                 : step.state == "denied"    ? CodexTheme.text_muted
                 : CodexTheme.accent;
            font-size: 10px;
            vertical-alignment: center;
        }

        Text {
            text: step.name;
            font-family: CodexTheme.font_mono;
            font-size: 11px;
            font-weight: 600;
            color: CodexTheme.text_white;
            vertical-alignment: center;
        }

        Text {
            text: step.detail;
            font-family: CodexTheme.font_mono;
            font-size: 11px;
            color: CodexTheme.text_muted;
            vertical-alignment: center;
            overflow: elide;
        }

        // Inline approve/deny — sits on the tool line, not a side panel.
        if step.state == "awaiting_confirm": HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Rectangle {
                width: 56px; height: 20px; border-radius: 4px;
                background: CodexTheme.diff_add;
                Text {
                    text: "allow";
                    font-family: CodexTheme.font_sans; font-size: 10px; font-weight: 600;
                    color: CodexTheme.bg_workspace;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.approve(step.id); } }
            }
            Rectangle {
                width: 56px; height: 20px; border-radius: 4px;
                border-width: 1px; border-color: CodexTheme.border_hairline;
                background: CodexTheme.bg_card;
                Text {
                    text: "deny";
                    font-family: CodexTheme.font_sans; font-size: 10px;
                    color: CodexTheme.text_secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.deny(step.id); } }
            }
        }
    }
}

// DiffStage — the right-hand review canvas. Rises when a destructive tool is
// pending or files changed; line-level diff + per-hunk Accept/Revert bar.
// Spec: codex-desktop-design.md §3.

import { ListView } from "std-widgets.slint";
import { CodexTheme } from "../codex_theme.slint";
import { Bridge, DiffLineData, PendingApprovalData } from "../globals.slint";

component DiffRow inherits Rectangle {
    in property <DiffLineData> line;
    height: 20px;
    background: line.line_type == "add"    ? CodexTheme.diff_add_surface
              : line.line_type == "delete" ? CodexTheme.diff_del_surface
              : transparent;

    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        // gutter sign
        Text {
            width: 12px;
            text: line.line_type == "add" ? "+" : line.line_type == "delete" ? "−" : " ";
            font-family: CodexTheme.font_mono;
            font-size: 11px;
            color: line.line_type == "add" ? CodexTheme.diff_add
                 : line.line_type == "delete" ? CodexTheme.diff_del
                 : CodexTheme.text_dim;
            vertical-alignment: center;
        }
        // old/new line numbers
        Text {
            width: 64px;
            text: (line.old_lineno >= 0 ? line.old_lineno : "")
                + " " + (line.new_lineno >= 0 ? line.new_lineno : "");
            font-family: CodexTheme.font_mono;
            font-size: 10px;
            color: CodexTheme.text_dim;
            vertical-alignment: center;
        }
        Text {
            text: line.content;
            font-family: CodexTheme.font_mono;
            font-size: 12px;
            color: line.line_type == "context" ? CodexTheme.text_secondary : CodexTheme.text_white;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component DiffStage inherits Rectangle {
    in property <PendingApprovalData> pending;
    in property <[DiffLineData]> diff_lines;
    in property <[string]> changed_files;
    background: CodexTheme.bg_workspace;

    VerticalLayout {
        // ---- review bar ----
        VerticalLayout {
        Rectangle {
            height: 48px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        vertical-alignment: center;
                        text: pending.tool_name != "" ? pending.title : "No pending changes";
                        font-family: CodexTheme.font_mono;
                        font-size: 12px;
                        font-weight: 600;
                        color: CodexTheme.text_white;
                    }
                    if pending.risk == "critical": Text {
                        vertical-alignment: center;
                        text: "  CRITICAL — " + pending.audit_reason;
                        font-family: CodexTheme.font_sans;
                        font-size: 11px;
                        color: CodexTheme.error;
                    }
                }

                // review actions — only while a destructive op is pending
                if pending.tool_name != "": HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: CodexTheme.border_hairline;
                        background: CodexTheme.bg_card;
                        HorizontalLayout { padding-left: 10px; padding-right: 10px;
                        Text {
                            text: "Revert (Esc)";
                            font-family: CodexTheme.font_sans;
                            font-size: 11px;
                            color: CodexTheme.text_secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        }
                        TouchArea { clicked => { Bridge.deny_tool(pending.step_id, ""); } }
                    }
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: CodexTheme.text_white;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                        Text {
                            text: "Accept (⌘Y)";
                            font-family: CodexTheme.font_sans;
                            font-size: 11px;
                            font-weight: 600;
                            color: CodexTheme.bg_workspace;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        }
                        TouchArea { clicked => { Bridge.approve_tool(pending.step_id, false); } }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: CodexTheme.border_hairline; }
        }

        // ---- diff body (virtualized; 20px rows) ----
        if pending.tool_name != "": ListView {
            for line in diff_lines: DiffRow { line: line; }
        }

        // ---- changed-files list when idle ----
        if pending.tool_name == "" && changed_files.length > 0: VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "CHANGED FILES";
                font-family: CodexTheme.font_mono;
                font-size: 10px;
                font-weight: 700;
                color: CodexTheme.text_muted;
                letter-spacing: 1px;
            }
            for f in changed_files: Text {
                text: f;
                font-family: CodexTheme.font_mono;
                font-size: 11px;
                color: CodexTheme.text_secondary;
            }
        }

        // ---- empty state ----
        if pending.tool_name == "" && changed_files.length == 0: Rectangle {
            Text {
                text: "Changes will appear here for review";
                font-family: CodexTheme.font_sans;
                font-size: 12px;
                color: CodexTheme.text_dim;
            }
        }
    }
}

// CodexDesktop — session browser + chat stream workbench.
// Left: session list (sidebar). Middle: the conversation stream (fills
// remaining width). Diff stage slides in from the right only when a
// pending approval exists.

import { CodexTheme } from "codex_theme.slint";
import {
    Bridge,
    ActionStepData,
    DiffLineData,
    ModelOption,
    PendingApprovalData,
    SessionData,
    SessionMessageData,
    SessionStats,
} from "globals.slint";
import { SessionSidebar } from "views/sidebar.slint";
import { ExecutionStream } from "views/execution_stream.slint";
import { DiffStage } from "components/diff_stage.slint";

// Re-export the globals + structs so Rust's `slint::include_modules!` sees
// them as the public API surface of this component file.
export { Bridge, CodexTheme }
export { ActionStepData, DiffLineData, ModelOption, PendingApprovalData,
         SessionData, SessionMessageData, SessionStats }

export component CodexDesktop inherits Window {
    title: "agent-rs";
    min-width: 960px;
    min-height: 640px;
    background: CodexTheme.bg_workspace;

    HorizontalLayout {
        spacing: 0px;

        SessionSidebar {}
        Rectangle { width: 1px; background: CodexTheme.border_hairline; }

        // Chat stream fills all remaining width.
        ExecutionStream {
            horizontal-stretch: 1;
        }

        // Diff stage — a right-side drawer that only exists while a
        // tool approval is pending (zero-width otherwise so the chat
        // keeps the full width).
        if Bridge.pending.tool_name != "": Rectangle {
            width: 1px;
            background: CodexTheme.border_hairline;
        }
        if Bridge.pending.tool_name != "": DiffStage {
            width: 360px;
            pending: Bridge.pending;
            diff_lines: Bridge.pending_diff;
            changed_files: Bridge.changed_files;
        }
    }
}

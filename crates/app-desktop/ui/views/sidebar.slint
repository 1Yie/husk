// SessionSidebar — the left column: workspace header + session list +
// new-session button. Slim (64px icon rail → 220px session browser).

import { ListView } from "std-widgets.slint";
import { CodexTheme } from "../codex_theme.slint";
import { Bridge } from "../globals.slint";

component SessionRow inherits Rectangle {
    in property <string> title;
    in property <string> preview;
    in property <string> timestamp;
    in property <bool> active;
    callback clicked();

    height: 64px;
    border-radius: 6px;
    background: root.active ? CodexTheme.bg_card : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: CodexTheme.border_hairline;

    TouchArea { clicked => { root.clicked(); } }

    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: root.active ? CodexTheme.accent : CodexTheme.text_dim;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.title;
                font-family: CodexTheme.font_sans;
                font-size: 12px;
                font-weight: root.active ? 600 : 400;
                color: root.active ? CodexTheme.text_white : CodexTheme.text_secondary;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.timestamp;
                font-family: CodexTheme.font_mono;
                font-size: 9px;
                color: CodexTheme.text_dim;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.preview;
            font-family: CodexTheme.font_sans;
            font-size: 11px;
            color: CodexTheme.text_muted;
            overflow: elide;
        }
    }
}

export component SessionSidebar inherits Rectangle {
    width: 220px;
    background: CodexTheme.bg_panel;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // ---- workspace header ----
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px; height: 26px; border-radius: 6px;
                background: CodexTheme.bg_hover;
                Text {
                    text: "◈";
                    color: CodexTheme.text_white;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 1px;
                Text {
                    text: "agent-rs";
                    font-family: CodexTheme.font_sans;
                    font-size: 13px;
                    font-weight: 600;
                    color: CodexTheme.text_white;
                }
                Text {
                    text: "workspace";
                    font-family: CodexTheme.font_mono;
                    font-size: 9px;
                    color: CodexTheme.text_dim;
                }
            }
        }

        // ---- new session button ----
        Rectangle {
            height: 30px;
            border-radius: 6px;
            border-width: 1px;
            border-color: CodexTheme.border_hairline;
            background: CodexTheme.bg_card;
            HorizontalLayout {
                padding-left: 10px;
                spacing: 6px;
                Text {
                    text: "+";
                    color: CodexTheme.accent;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: "New session";
                    font-family: CodexTheme.font_sans;
                    font-size: 12px;
                    color: CodexTheme.text_white;
                    vertical-alignment: center;
                }
            }
            TouchArea { clicked => { Bridge.new_session(); } }
        }

        // ---- session list ----
        Text {
            text: "SESSIONS";
            font-family: CodexTheme.font_mono;
            font-size: 9px;
            font-weight: 700;
            color: CodexTheme.text_dim;
            letter-spacing: 1px;
        }
        ListView {
            vertical-stretch: 1;
            for s in Bridge.sessions: SessionRow {
                title: s.title;
                preview: s.preview;
                timestamp: s.timestamp;
                active: s.active;
                clicked => { Bridge.select_session(s.id); }
            }
        }

        // ---- footer: sandbox + model status ----
        Rectangle {
            height: 1px;
            background: CodexTheme.border_hairline;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: Bridge.sandbox_unsafe ? "⚠" : "⛨";
                font-size: 12px;
                color: Bridge.sandbox_unsafe ? CodexTheme.warn : CodexTheme.diff_add;
                vertical-alignment: center;
            }
            Text {
                text: Bridge.stats.active_model;
                font-family: CodexTheme.font_mono;
                font-size: 10px;
                color: CodexTheme.text_dim;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: Bridge.stats.permission_mode;
                font-family: CodexTheme.font_mono;
                font-size: 9px;
                color: CodexTheme.text_muted;
                vertical-alignment: center;
            }
        }
    }
}

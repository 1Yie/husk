// Shared structs + the Bridge global — the wire contract between Rust and
// Slint. Shapes mirror agent-ipc's UiEvent/UiCommand (kernel never imports
// Slint; this crate translates).

// ---- Structs (Rust side: slint::Struct mirrors) ----

export struct DiffLineData {
    line_type: string,      // "add" | "delete" | "context"
    content: string,
    old_lineno: int,        // -1 when n/a
    new_lineno: int,
}

export struct ActionStepData {
    id: int,
    name: string,           // "fuzzy_patch", "bash"…
    state: string,          // "running"|"awaiting_confirm"|"success"|"error"|"denied"
    detail: string,         // one-line summary
    expandable: bool,
}

export struct SessionMessageData {
    id: int,
    role: string,           // "user" | "agent" | "system" | "tool"
    text: string,
    reasoning: string,
    has_diff: bool,
    streaming: bool,
}

export struct PendingApprovalData {
    step_id: int,
    tool_name: string,
    title: string,
    command: string,
    risk: string,           // "normal"|"elevated"|"critical"|"network"
    audit_reason: string,
    diff_text: string,      // raw unified diff — parsed into lines by Rust
    fuzzy: bool,
}

export struct SessionStats {
    tokens_used: int,
    context_window: int,
    files_changed: int,
    agent_state: string,    // mirrors AgentState
    permission_mode: string,
    active_provider: string,
    active_model: string,
    degraded: bool,
}

export struct ModelOption {
    provider_id: string,
    label: string,
    model: string,
    available: bool,
}

export struct SessionData {
    id: int,
    title: string,
    preview: string,        // last message snippet
    active: bool,
    timestamp: string,
}

// ---- Bridge: Rust implements callbacks + pushes property updates ----

export global Bridge {
    // UI → kernel
    callback submit_prompt(string);
    callback steer(string);
    callback approve_tool(int /*step_id*/, bool /*remember*/);
    callback deny_tool(int /*step_id*/, string /*reason*/);
    callback cancel_turn();
    callback undo_turn(int /*turn*/);
    callback set_model(string /*provider_id*/, string /*model*/);
    callback new_session();
    callback select_session(int /*id*/);

    // kernel → UI (Rust sets these; Slint reads)
    in-out property <[SessionData]> sessions;
    in-out property <[SessionMessageData]> messages;
    in-out property <[ActionStepData]> active_steps;
    in-out property <PendingApprovalData> pending;   // .tool_name == "" → none
    in-out property <[DiffLineData]> pending_diff;    // parsed lines for stage
    in-out property <[string]> changed_files;
    in-out property <[ModelOption]> model_options;
    in-out property <SessionStats> stats;
    in-out property <bool> sandbox_unsafe;
    in-out property <bool> steered;
    // True while the kernel is mid-turn — drives the loading bubble.
    in-out property <bool> is_active;
}

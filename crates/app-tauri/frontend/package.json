{
  "name": "husk-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scroll": "node scripts/chat-scroll/check.mjs",
    "test:terminal": "node scripts/terminal-reveal/check.mjs",
    "test:terminal:production": "node scripts/terminal-reveal/production-check.mjs",
    "test:terminal:resize": "node scripts/terminal-reveal/check.mjs --resize",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "check:colors": "node scripts/check-theme-colors.mjs"
  },
  "dependencies": {

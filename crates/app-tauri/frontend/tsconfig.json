{
	"compilerOptions": {
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2021",
		"useDefineForClassFields": true
	},
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],
	"include": ["src"]
}

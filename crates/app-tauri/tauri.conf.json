{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Husk",
  "version": "0.1.4",
  "identifier": "husk.ingstar.im",
  "build": {
    "frontendDist": "./frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Husk",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Development",
    "shortDescription": "AI coding agent — desktop shell",
    "longDescription": "Husk is a desktop AI coding agent: a React/Tailwind frontend over a shared Rust kernel with providers, tools, subagents and MCP plugins.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/husk.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/husk.desktop"
      }
    }
  }
}
